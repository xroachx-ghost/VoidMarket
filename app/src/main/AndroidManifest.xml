<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.voidmarket">
    <!-- Permissions: foreground-only, privacy-safe -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <!-- Optional: location only if user enables LiveMap -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    
    <application
        android:allowBackup="false"
        android:label="VOID MARKET"
        android:theme="@style/Theme.VoidMarket"
        android:usesCleartextTraffic="false">
        
        <!-- Splash screen -->
        <activity
            android:name=".ui.screens.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.VoidMarket.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"/>
        
        <!-- Metadata for ownership and branding -->
        <meta-data android:name="OWNER" android:value="Roach Security Labs"/>
        <meta-data android:name="APP_VERSION" android:value="1.0.0"/>
    </application>
</manifest>
